{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-ext-filesize",
    "description": "Hauer-Heinrich - List all file-sizes within given directory which are greater then e. g. 300kb.",
    "keywords": [ "TYPO3 CMS", "TYPO3", "faq", "extension" ],
    "homepage": "https://www.hauer-heinrich.de",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "http://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_ext_filesize/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_ext_filesize",
        "docs": "https://github.com/Hauer-Heinrich/hh_ext_filesize/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "php": ">=8.4",
        "typo3/cms-core": "^13.4.0 || ^14.3.0"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhExtFilesize\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HauerHeinrich\\HhExtFilesize\\Tests\\": "Tests"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_ext_filesize",
            "version": "3.2.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
